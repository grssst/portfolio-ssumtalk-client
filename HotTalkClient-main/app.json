      "API_URL": "https://ssumtalk.com",  //해당 DNS는 더이상 유지되지 않습니다.
      //"API_URL": "http://192.168.0.2:5000",
      "WEB_CLIENT_ID" : "********.apps.googleusercontent.com",
      "ANDROID_CLIENT_ID" : "*************.apps.googleusercontent.com",
      "FIREBASE_WEB_CLIENT_ID" : "************.apps.googleusercontent.com",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "*******"
      }
    }
  }
}
